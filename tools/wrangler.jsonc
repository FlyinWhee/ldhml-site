// Cloudflare Worker for the LDHML tools (admin area now, captain area later). See tools/CLAUDE.md and docs/tools.md.
// Secrets are NOT here: set them with "npx wrangler secret put <NAME> -c tools/wrangler.jsonc" (CODE_PEPPER, RESEND_API_KEY).
// Local development reads them from tools/.dev.vars (git-ignored).
{
  "name": "ldhml-tools",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../dist-tools",
    "binding": "ASSETS",
    // the API, and the area pages: on admin.ldhml.com and capitaine.ldhml.com "/" is the area (src/worker.js areaRoute)
    "run_worker_first": ["/api/*", "/", "/admin/", "/admin/index.html", "/captain/", "/captain/index.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ldhml-tools",
      // Created 2026-11-20 ("npx wrangler d1 create ldhml-tools"): the real tools database (admin.ldhml.com, capitaine.ldhml.com).
      "database_id": "6eb85712-095a-4f7c-be77-c3fb6e139931",
      "migrations_dir": "migrations"
    }
  ],
  // The real tools (owner, 2026-11-20): admin.ldhml.com and capitaine.ldhml.com, one area per address (src/worker.js).
  "routes": [
    { "pattern": "admin.ldhml.com", "custom_domain": true },
    { "pattern": "capitaine.ldhml.com", "custom_domain": true }
  ],
  // Sign-in codes: Cloudflare Email Service (Workers Paid). The domain is onboarded in the dashboard (Email Service > Email Sending).
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@ldhml.com"] }],
  "vars": {
    // "console" prints sign-in codes to the log (local only: tools/.dev.vars sets it). Production: "cloudflare" (src/email.js).
    "EMAIL_MODE": "cloudflare",
    "EMAIL_FROM": "no-reply@ldhml.com",
    "ADMIN_URL": "https://admin.ldhml.com/",
    "CAPTAIN_URL": "https://capitaine.ldhml.com/"
  },
  "observability": { "enabled": true },
  // The online demo (read only; docs/tools.md): its own Worker and its own demo database. Deploy: npx wrangler deploy -c tools/wrangler.jsonc --env demo
  // Secrets of the demo: CODE_PEPPER, DEMO_KEY and GITHUB_TOKEN (the stats site refresh: a fine-grained token, repo ldhml-site only, Contents read and write, Actions read) (npx wrangler secret put <NAME> -c tools/wrangler.jsonc --env demo).
  "env": {
    "demo": {
      "name": "ldhml-tools-demo",
      // never the real addresses: "routes" is inherited, and a demo deploy would take admin.ldhml.com and capitaine.ldhml.com (2026-11-20)
      "routes": [],
      "workers_dev": true,
      // no email in the demo (sign-in with the demo key); no ADMIN_URL / CAPTAIN_URL: both areas on the workers.dev address
      "send_email": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ldhml-tools-demo",
          // Created 2026-10-18 ("npx wrangler d1 create ldhml-tools-demo").
          "database_id": "fb006bd7-bec3-4c4b-afbc-5821fc62bcce",
          "migrations_dir": "migrations"
        }
      ],
      // DEMO=1: every write refused; the demo key signs in (src/demo.js). The demo admin is a super admin (a fake address).
      "vars": { "DEMO": "1", "EMAIL_MODE": "console", "EMAIL_FROM": "", "SUPER_ADMINS": "demo@demo.invalid" }
    }
  }
}
