// Cloudflare Worker for the LDHML tools (admin area now, captain area later). See tools/CLAUDE.md and docs/tools.md.
// Secrets are NOT here: set them with "npx wrangler secret put <NAME> -c tools/wrangler.jsonc" (CODE_PEPPER, RESEND_API_KEY).
// Local development reads them from tools/.dev.vars (git-ignored).
{
  "name": "ldhml-tools",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../dist-tools",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ldhml-tools",
      // Replace with the id printed by "npx wrangler d1 create ldhml-tools" (docs/tools.md, step 2).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "console" prints sign-in codes to the log (local only, refused elsewhere). Production: "resend".
    "EMAIL_MODE": "console",
    "EMAIL_FROM": ""
  },
  "observability": { "enabled": true },
  // The online demo (read only; docs/tools.md): its own Worker and its own demo database. Deploy: npx wrangler deploy -c tools/wrangler.jsonc --env demo
  // Secrets of the demo: CODE_PEPPER, DEMO_KEY and GITHUB_TOKEN (the stats site refresh: a fine-grained token, repo ldhml-site only, Contents read and write, Actions read) (npx wrangler secret put <NAME> -c tools/wrangler.jsonc --env demo).
  "env": {
    "demo": {
      "name": "ldhml-tools-demo",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ldhml-tools-demo",
          // Created 2026-10-18 ("npx wrangler d1 create ldhml-tools-demo").
          "database_id": "fb006bd7-bec3-4c4b-afbc-5821fc62bcce",
          "migrations_dir": "migrations"
        }
      ],
      // DEMO=1: every write refused; the demo key signs in (src/demo.js). The demo admin is a super admin (a fake address).
      "vars": { "DEMO": "1", "EMAIL_MODE": "console", "EMAIL_FROM": "", "SUPER_ADMINS": "demo@demo.invalid" }
    }
  }
}
